<odoo>
    <data>
        <!--  Heredar el layout Bubble para intercambiar dirección del cliente y número de factura  -->
        <template id="external_layout_bubble_inherit" inherit_id="web.external_layout_bubble">
            <!--  Reemplazar la tabla completa para intercambiar las columnas  -->
            <xpath expr="//table[@class='o_ignore_layout_styling table table-borderless mb-0']" position="replace">
                <table class="o_ignore_layout_styling table table-borderless mb-0">
                    <tbody>
                        <tr>
                            <!--  NÚMERO DE FACTURA A LA IZQUIERDA  -->
                            <td t-if="not information_block" class="align-bottom p-0 pe-2">
                                <h2 class="mb-4 text-nowrap" t-out="layout_document_title"/>
                            </td>
                            <!--  DIRECCIÓN DEL CLIENTE A LA DERECHA  -->
                            <td class="p-0" style="vertical-align: top; width: 100%; min-width: 100%;">
                                <div style="margin-left: -450px; margin-top: -6px;">
                                    <t t-call="web.address_layout"/>
                                </div>
                            </td>
                        </tr>
                        <tr t-if="information_block">
                            <td colspan="2" class="align-bottom p-0">
                                <h2 class="text-nowrap" t-out="layout_document_title"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </xpath>
            <!--  Subir ligeramente la información de la empresa (logo y datos)  -->
            <xpath expr="//div[@name='company_address']" position="attributes">
                <attribute name="style">margin-top: -25px;</attribute>
            </xpath>
        </template>
        <!-- Herencia para ocultar el número de cuenta bancaria en el reporte de factura -->
        <template id="report_invoice_payment_mode_no_acc_number" inherit_id="account_payment_partner.report_invoice_payment_mode">
            <!-- Eliminar el <p> que contiene la cuenta bancaria, usando t-foreach como selector -->
            <xpath expr="//p[@t-foreach='o.sudo().partner_banks_to_show()']" position="replace"/>
            <!-- Mostrar solo el método de pago cuando sea 'Pagaré' -->
            <xpath expr="//span[@t-field='o.narration']/.." position="before">
                <t t-if="o.payment_mode_id and o.payment_mode_id.name == 'Pagaré'">
                    <p><strong>Método de pago:</strong> Pagaré</p>
                </t>
            </xpath>
        </template>
        <!-- Herencia para ocultar la comunicación bancaria solo si el método de pago es 'Pagaré' -->
        <template id="report_invoice_hide_payment_communication_pagares" inherit_id="account.report_invoice_document">
            <xpath expr="//div[@class='mb-3' and p[@name='payment_communication']]" position="replace">
                <div class="mb-3" t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference and (not o.payment_mode_id or o.payment_mode_id.name != 'Pagaré')">
                    <p name="payment_communication">
                        Payment Communication: <span class="fw-bold" t-field="o.payment_reference">INV/2023/00001</span>
                        <t t-if="o.partner_bank_id">
                            <br/> on this account: <span t-field="o.partner_bank_id" class="fw-bold"/>
                        </t>
                    </p>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
